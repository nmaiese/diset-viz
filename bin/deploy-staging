#!/bin/sh
# Lancia scripts/deploy_staging.py. Solo libreria standard: va bene qualunque python3,
# anche quello dell'immagine gcloud usata da Cloud Build. Su Windows e' Git Bash
# (oppure: bin\py scripts\deploy_staging.py).
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for candidate in "${DIVARIO_PYTHON:-}" "$here/.venv/bin/python" "$here/.venv/Scripts/python.exe" python3 python; do
    [ -n "$candidate" ] || continue
    command -v "$candidate" >/dev/null 2>&1 || continue
    exec "$candidate" "$here/scripts/deploy_staging.py" "$@"
done
echo "deploy-staging: nessun interprete python trovato." >&2
exit 127
