#!/bin/sh
# Una copia del sito su una seconda URL, per guardarla prima che il branch
# tocchi master.
#
# Deploya il worktree COM'E', non un branch remoto: `gcloud run deploy
# --source .` manda a Cloud Build il contenuto della cartella, quindi si guarda
# esattamente quello che si ha davanti, anche non committato. E' il punto:
# uno stage che deploya `master` non serve a decidere se mandare una modifica
# in master.
#
#     bin/deploy-staging
#
# Lo stesso script lo esegue Cloud Build a ogni push sul branch `stage`
# (cloudbuild-staging.yaml), passando STAGING_IMAGE con l'immagine gia'
# costruita: cosi' il deploy automatico e quello a mano fanno le stesse cose e
# soprattutto passano dalle stesse verifiche, invece di somigliarsi.
#
# Il servizio e' separato da quello di produzione e non ne eredita niente:
#
#   - `--set-env-vars` (non `--update-env-vars`) azzera l'ambiente e imposta
#     solo STAGING=1. Quindi niente GTM, niente GA, niente AdSense, niente
#     verifiche di proprieta': sono tutte env-gated e qui non ci sono.
#   - Senza DATABASE_URL l'app cade sullo SQLite locale del container, che e'
#     effimero. Lo stage NON puo' scrivere sul Postgres di produzione: nessuna
#     classifica vera, nessun account vero, nessun dato utente toccato.
#   - STAGING=1 rende ogni risposta `noindex, nofollow, noarchive` e fa dire a
#     /robots.txt `Disallow: /`. Senza, Google si troverebbe un duplicato
#     completo di divarioitalia.it su un secondo dominio.
#   - STAGING_PASSWORD chiude tutto dietro un Basic Auth. `noindex` parla ai
#     crawler educati; la password parla a tutti gli altri. Questo script ne
#     genera una al primo deploy e poi la RIUSA, cosi' la si puo' passare a
#     qualcuno una volta sola e resta buona a ogni rilascio. Per sceglierla:
#     STAGING_PASSWORD=... bin/deploy-staging
#
# Le tre cose qui sopra sono verificate alla fine da questo script: se una
# salta, il deploy e' andato ma lo script esce rosso e lo dice.
set -eu

SERVICE="${STAGING_SERVICE:-diset-viz-staging}"
REGION="${STAGING_REGION:-europe-west1}"

here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$here"

if ! command -v gcloud >/dev/null 2>&1; then
    echo "deploy-staging: gcloud non e' installato." >&2
    echo "  https://cloud.google.com/sdk/docs/install" >&2
    exit 127
fi

account=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null || true)
if [ -z "$account" ]; then
    echo "deploy-staging: nessun account gcloud attivo. Esegui:  gcloud auth login" >&2
    exit 1
fi

project=$(gcloud config get-value project 2>/dev/null || true)
if [ -z "$project" ] || [ "$project" = "(unset)" ]; then
    echo "deploy-staging: nessun progetto impostato. Esegui:  gcloud config set project IL_TUO_PROGETTO" >&2
    exit 1
fi

# La password dello stage, in ordine: quella gia' sul servizio (per non
# invalidare il link che qualcuno ha in mano), poi quella chiesta
# dall'ambiente, infine una generata. Non esiste il caso "senza password": uno
# stage pubblico e' il sito intero leggibile da chiunque ne indovini la URL.
existing_password=$(gcloud run services describe "$SERVICE" --region "$REGION" \
    --format='value(spec.template.spec.containers[0].env.filter("name:STAGING_PASSWORD").extract("value"))' 2>/dev/null || true)

password="${STAGING_PASSWORD:-$existing_password}"
password_origin="riusata dal servizio"
if [ -n "${STAGING_PASSWORD:-}" ]; then
    password_origin="presa da STAGING_PASSWORD"
fi
if [ -z "$password" ]; then
    password=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20)
    password_origin="generata adesso"
fi

# `--set-env-vars` separa le variabili con la virgola, quindi una password che
# ne contiene una arriverebbe troncata sul servizio e lo stage risponderebbe
# 401 a chi usa la password giusta. Meglio dirlo qui che scoprirlo dopo.
case "$password" in
    *[!A-Za-z0-9._~-]*)
        echo "deploy-staging: la password puo' contenere solo lettere, cifre e . _ ~ -" >&2
        echo "  (la virgola separa le variabili d'ambiente di gcloud)" >&2
        exit 1 ;;
esac

user="${STAGING_USER:-divario}"

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
dirty=""
if [ -z "${STAGING_IMAGE:-}" ] && ! git diff --quiet HEAD 2>/dev/null; then
    dirty=" (con modifiche non committate)"
fi

if [ -n "${STAGING_IMAGE:-}" ]; then
    source_label="immagine $STAGING_IMAGE"
else
    source_label="$branch$dirty"
fi

echo "Stage di Divario Italia"
echo "  progetto: $project"
echo "  servizio: $SERVICE ($REGION)"
echo "  sorgente: $source_label"
echo

# Primo deploy: crea il servizio e imposta l'ambiente minimo. SITE_URL non si
# conosce ancora (la assegna Cloud Run), quindi si sistema subito dopo.
# Con STAGING_IMAGE si deploya un'immagine gia' costruita (Cloud Build l'ha
# appena fatta); senza, `--source .` manda a Cloud Build il worktree com'e',
# che e' il punto quando si lancia da un portatile.
if [ -n "${STAGING_IMAGE:-}" ]; then
    set -- --image "$STAGING_IMAGE"
else
    set -- --source .
fi

gcloud run deploy "$SERVICE" \
    "$@" \
    --region "$REGION" \
    --allow-unauthenticated \
    --min-instances 0 \
    --memory 1Gi \
    --set-env-vars "STAGING=1,STAGING_USER=$user,STAGING_PASSWORD=$password" \
    --quiet

url=$(gcloud run services describe "$SERVICE" --region "$REGION" --format='value(status.url)')
if [ -z "$url" ]; then
    echo "deploy-staging: deploy fatto ma non riesco a leggere la URL del servizio." >&2
    exit 1
fi

# SITE_URL deve essere quella dello stage, non quella di produzione: canonical,
# og:url e i link assoluti altrimenti rimandano al sito vero, e ci si ritrova a
# guardare la produzione credendo di guardare lo stage.
current_site_url=$(gcloud run services describe "$SERVICE" --region "$REGION" \
    --format='value(spec.template.spec.containers[0].env.filter("name:SITE_URL").extract("value"))' 2>/dev/null || true)
if [ "$current_site_url" != "$url" ]; then
    gcloud run services update "$SERVICE" --region "$REGION" \
        --update-env-vars "SITE_URL=$url" --quiet >/dev/null
fi

echo
echo "Stage online:  $url"
echo

# --- verifiche ------------------------------------------------------------
# Non "il deploy e' riuscito", ma "lo stage si comporta da stage". Un 200 sulla
# home non dice niente sul rischio vero, che e' l'indicizzazione.
fail=0

# La prima verifica e' che lo stage sia chiuso. Se questa salta, le altre non
# contano: il sito intero e' leggibile da chiunque abbia la URL.
anon_status=$(curl -sS -o /dev/null -w '%{http_code}' "$url/")
if [ "$anon_status" = "401" ]; then
    echo "  ok    senza password la home risponde 401"
else
    echo "  ROTTO senza password la home risponde $anon_status, doveva essere 401" >&2
    fail=1
fi

wrong_status=$(curl -sS -o /dev/null -w '%{http_code}' -u "$user:password-sbagliata-di-prova" "$url/")
if [ "$wrong_status" = "401" ]; then
    echo "  ok    una password sbagliata risponde 401"
else
    echo "  ROTTO una password sbagliata risponde $wrong_status, doveva essere 401" >&2
    fail=1
fi

auth_status=$(curl -sS -o /dev/null -w '%{http_code}' -u "$user:$password" "$url/")
if [ "$auth_status" = "200" ]; then
    echo "  ok    con la password la home si apre"
else
    echo "  ROTTO con la password la home risponde $auth_status, doveva essere 200" >&2
    fail=1
fi

robots_header=$(curl -sS -I -u "$user:$password" "$url/" | tr -d '\r' | awk -F': ' 'tolower($1)=="x-robots-tag"{print $2}')
case "$robots_header" in
    *noindex*) echo "  ok    X-Robots-Tag: $robots_header" ;;
    *) echo "  ROTTO X-Robots-Tag sulla home: '${robots_header:-assente}', doveva essere noindex" >&2; fail=1 ;;
esac

# Senza credenziali apposta: il file che nega la scansione vale solo se un
# crawler lo puo' leggere. Dietro al 401 vedrebbe un errore, non un divieto.
robots_txt=$(curl -sS "$url/robots.txt")
case "$robots_txt" in
    *"Disallow: /"*) echo "  ok    /robots.txt vieta la scansione" ;;
    *) echo "  ROTTO /robots.txt non contiene 'Disallow: /'" >&2; fail=1 ;;
esac

home=$(curl -sS -u "$user:$password" "$url/")
case "$home" in
    *"Ambiente di stage"*) echo "  ok    la fascia di stage e' in pagina" ;;
    *) echo "  ROTTO la fascia di stage non compare: la copia e' indistinguibile dal sito vero" >&2; fail=1 ;;
esac

case "$home" in
    *googletagmanager*) echo "  ROTTO Google Tag Manager e' attivo sullo stage" >&2; fail=1 ;;
    *) echo "  ok    nessun tag di analytics" ;;
esac

echo
if [ "$fail" -ne 0 ]; then
    echo "Lo stage e' online ma NON si comporta da stage: leggi i ROTTO qui sopra." >&2
    exit 1
fi

echo "Credenziali dello stage ($password_origin):"
echo "  utente:   $user"
echo "  password: $password"
echo
echo "Da guardare:"
echo "  $url/                     la home (design system 2026)"
echo "  $url/blog                 una pagina non ancora migrata"
echo "  $url/atlante              la SPA"
echo
echo "Per spegnerlo:  gcloud run services delete $SERVICE --region $REGION"
