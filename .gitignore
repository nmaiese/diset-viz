*.DS_Store
*.pyc
.venv/
.venv3/
__pycache__/
.idea/
.vscode/
node_modules/
frontend/node_modules/

# Secrets / credentials — never commit
client_secret_*.json
*.apps.googleusercontent.com.json
*.env
.env
!.env.example

# Raw Istat SDMX response cache (bulky; the normalized CSVs are committed instead)
data/istat_cache/

# Raw Eurostat API response cache (offline fixtures are committed instead)
data/eurostat_cache/

# Quiz leaderboard SQLite file (local/runtime state, not source data)
data/*.sqlite3
data/*.sqlite3-*

# Cruscotto della catena: rigenerato da scripts/pipeline_dashboard.py.
# Il diario (data/pipeline/runs.jsonl) invece e' committato: e' la storia.
data/pipeline/cruscotto.html

# Stato locale della sessione Claude Code: lo scrivono gli hook, lo legge
# pipeline_log.py per arricchire il diario. Mai committato: e' della sessione.
data/pipeline/.session_meta.json
data/pipeline/tool_failures.jsonl

# I battiti dei ruoli in volo: li scrive scripts/pipeline_monitor all'avvio e li
# cancella alla chiusura, il cruscotto /_pipeline li legge per il "vivo". Sono
# della sessione, non storia: la storia sta nel diario e nei file committati.
data/pipeline/heartbeats/

# Directory di lavoro delle eval degli agenti: le fixture sono committate,
# quello che un agente produce durante una eval no.
evals/out/
