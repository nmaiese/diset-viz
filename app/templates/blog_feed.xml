{#- Il feed del blog, RSS 2.0.

    Non e' nostalgia. La sitemap dice a un crawler che una pagina esiste, il
    feed dice a chi gia' ci segue che e' uscita: aggregatori, newsletter, e le
    catene che leggono un sito senza ripassare dall'indice. Costava tre rotte
    404 (/feed.xml, /rss.xml, /blog/feed.xml), tutte e tre provate da qualcuno.

    `description` porta l'attacco, non il pezzo intero: il corpo completo sta
    nella pagina e nella sua variante Markdown, e un feed che lo duplica e' una
    terza copia da tenere in riga. -#}
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site_name }}, storie dai dati</title>
    <link>{{ site_url }}/blog</link>
    <atom:link href="{{ site_url }}/blog/feed.xml" rel="self" type="application/rss+xml" />
    <description>Analisi sui divari territoriali italiani, dagli indicatori Istat ed Eurostat.</description>
    <language>it-IT</language>
    {%- if updated %}
    <lastBuildDate>{{ updated }}</lastBuildDate>
    {%- endif %}
    {%- for post in posts %}
    <item>
      <title>{{ post.title }}</title>
      <link>{{ site_url }}/blog/{{ post.slug }}</link>
      <guid isPermaLink="true">{{ site_url }}/blog/{{ post.slug }}</guid>
      <pubDate>{{ post.pub_date }}</pubDate>
      <description>{{ post.description }}</description>
      {%- for tag in post.tags %}
      <category>{{ tag }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
