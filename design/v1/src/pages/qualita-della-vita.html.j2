{% extends "base.html.j2" %}
{% import "partials/ui.html.j2" as ui %}
{#- L'indice della qualita' della vita nella 1.0. Stesso contenuto di
    quality_life_index.html, un'altra regia: la risposta su dove si vive meglio,
    il doppio podio regioni e province con i link ai profili, i profili dei pesi
    con chi guadagna di piu', dove eccelle ogni territorio, il metodo in breve e
    i dati da scaricare. Usa gli stessi pezzi della classifica (qdv-). -#}
{% set r = d.regions %}
{% set p = d.provinces %}
{% set trail = [
  {"name": "Home", "path": "/"},
  {"name": "Qualità della vita", "path": "/qualita-della-vita"},
] %}
{% block main %}
{%- macro podium(b, ident) -%}
<div class="tablewrap qdv-rankbox qdv-rankbox--compact" tabindex="0" role="region" aria-labelledby="{{ aid(ident) }}">
  <table class="table qdv-rank qv-podium__table">
    <caption class="sr-only">Le prime {{ b.top | length }} e le ultime {{ b.bottom | length }} delle {{ b.n }} {{ b.spec.plural }}, punteggio da 0 a 100</caption>
    <thead><tr>
      <th class="rank" scope="col"><span aria-hidden="true">#</span><span class="sr-only">Posizione</span></th>
      <th scope="col">{{ b.spec.singular | capitalize }}</th>
      <th class="qdv-bar" scope="col"><span class="sr-only">Barra del punteggio</span></th>
      <th class="r" scope="col">Punteggio</th>
    </tr></thead>
    <tbody>
      {%- for row in b.top %}
      <tr data-key="{{ row.key }}"><td class="rank">{{ row.rank }}</td><th class="qdv-name" scope="row"><a href="{{ href(row.href) }}">{{ row.name }}</a>{% if row.region %}<span class="qdv-where">{% if row.region.href %}<a href="{{ href(row.region.href) }}">{{ row.region.name }}</a>{% else %}{{ row.region.name }}{% endif %}</span>{% endif %}</th><td class="qdv-bar" aria-hidden="true"><span class="score"><i style="width: {{ row.width }}%"></i></span></td><td class="val">{{ row.score }}</td></tr>
      {%- endfor %}
      {%- if b.gap_label %}
      <tr class="qdv-gap"><td colspan="4">{{ b.gap_label }}</td></tr>
      {%- endif %}
      {%- for row in b.bottom %}
      <tr data-key="{{ row.key }}"><td class="rank">{{ row.rank }}</td><th class="qdv-name" scope="row"><a href="{{ href(row.href) }}">{{ row.name }}</a>{% if row.region %}<span class="qdv-where">{% if row.region.href %}<a href="{{ href(row.region.href) }}">{{ row.region.name }}</a>{% else %}{{ row.region.name }}{% endif %}</span>{% endif %}</th><td class="qdv-bar" aria-hidden="true"><span class="score"><i style="width: {{ row.width }}%"></i></span></td><td class="val">{{ row.score }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}
<div class="wrap">
  {{ ui.crumbs(trail) }}

  <header class="pagehead">
    <p class="eyebrow">{{ d.institutions }}<span class="sep" aria-hidden="true">·</span>{{ r.n }} {{ r.spec.plural }} e {{ p.n }} {{ p.spec.plural }}<span class="sep" aria-hidden="true">·</span>dati {{ d.years_span }}</p>
    <h1 class="h-title">Qualità della vita nelle regioni e nelle province italiane</h1>
    <p class="answer">Fra le regioni il punteggio più alto è {{ r.first.prep }}<a href="{{ href(r.first.href) }}">{{ r.first.name }}</a>, {{ r.first.score }} su 100, e il più basso {{ r.last.prep }}<a href="{{ href(r.last.href) }}">{{ r.last.name }}</a>, {{ r.last.score }}. Fra le province il più alto è {{ p.first.prep }}<a href="{{ href(p.first.href) }}">{{ p.first.name }}</a>, {{ p.first.score }}, e il più basso {{ p.last.prep }}<a href="{{ href(p.last.href) }}">{{ p.last.name }}</a>, {{ p.last.score }}.</p>
    <p class="meta">
      <span>Profilo {{ d.default_name }}, lo stesso peso a ogni dimensione</span>
      <span>Non è la classifica del Sole 24 Ore</span>
      <a href="#{{ aid('metodo') }}">Come si calcola</a>
      <a href="{{ corrections_url }}">Segnala un errore</a>
    </p>
  </header>

  {{ ui.tiles(d.tiles) }}

  <section class="section" id="{{ aid('podio') }}" aria-labelledby="{{ aid('h-podio') }}">
    <h2 id="{{ aid('h-podio') }}">Chi è in testa e chi in coda</h2>
    <p class="subline qv-lead">Punteggio da 0 a 100 con il profilo {{ d.default_name }}.{% if r.fifty and p.fifty %} La tacca segna 50, la media semplice dei territori dello stesso livello.{% endif %} Ogni nome porta al profilo del territorio.</p>
    <div class="qv-podium">
      {% for b in d.levels %}
      <figure class="qv-podium__col">
        <figcaption><h3 class="h-sub" id="{{ aid('podio-' ~ b.spec.url) }}">Le {{ b.n }} {{ b.spec.plural }}</h3></figcaption>
        {{ podium(b, 'podio-' ~ b.spec.url) }}
        <p class="qv-podium__more"><a class="linkarrow" href="{{ href(b.href) }}">La classifica completa delle {{ b.spec.plural }}</a>
          {%- if b.level == 'provincia' %} <a class="linkarrow" href="{{ href(b.spec.index) }}">Trova la tua provincia</a>{% endif %}</p>
      </figure>
      {% endfor %}
    </div>
  </section>

  {{ ui.ad() }}

  <section class="section" id="{{ aid('profili') }}" aria-labelledby="{{ aid('h-profili') }}">
    <h2 id="{{ aid('h-profili') }}">Cambia le priorità</h2>
    <p class="subline qv-lead">Ogni profilo pesa le dimensioni in modo diverso, e la classifica cambia. Accanto a ognuno, chi guadagna più posizioni rispetto a {{ d.default_name }}.</p>
    <ul class="qv-profiles">
      {% for item in d.profiles %}
      <li>
        <h3 class="qv-profiles__name"><a href="{{ href(item.regions) }}">{{ item.name }}</a></h3>
        <p class="qv-profiles__desc">{{ item.description }}</p>
        {% if item.motive %}<p class="qv-profiles__why">{{ item.motive }}</p>{% else %}<p class="qv-profiles__why">È il profilo del podio qui sopra.</p>{% endif %}
        <p class="qv-profiles__links"><a href="{{ href(item.regions) }}">Le regioni con questo profilo</a> <a href="{{ href(item.provinces) }}">Le province</a></p>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="section" id="{{ aid('dove-eccelle') }}" aria-labelledby="{{ aid('h-eccelle') }}">
    <h2 id="{{ aid('h-eccelle') }}">Dove eccelle ogni territorio</h2>
    <figure class="module">
      <figcaption class="module__head">
        {% if r.claim %}<h3 class="h-sub">{{ r.claim }}</h3>{% endif %}
        <p class="subline">Per ognuna delle {{ d.champions | length }} dimensioni, la prima regione e la prima provincia. Il punteggio di una dimensione va da 0 a 100 e non cambia con il profilo.{% if p.missing %} Per le province mancano i dati su {{ p.missing | join(' e su ') }}.{% endif %}</p>
      </figcaption>
      <div class="tablewrap qdv-catbox" tabindex="0" role="region" aria-label="La prima regione e la prima provincia per dimensione">
        <table class="table table--compact qdv-cats">
          <caption class="sr-only">La prima regione e la prima provincia in ogni dimensione della qualità della vita</caption>
          <thead><tr><th scope="col">Dimensione</th><th scope="col">Prima regione</th><th scope="col">Prima provincia</th></tr></thead>
          <tbody>
            {%- for c in d.champions %}
            <tr>
              <th scope="row"><a href="{{ href(c.href) }}">{{ c.name }}</a></th>
              {%- for group, label in [(c.regions, 'Regione'), (c.provinces, 'Provincia')] %}
              <td data-label="{{ label }}">{% if group %}<span class="qdv-pair"><span>{% for t in group %}<a href="{{ href(t.href) }}">{{ t.name }}</a>{% if t.where %} <span class="qdv-where">{{ t.where }}</span>{% endif %}{% if not loop.last %}<span class="qdv-tie"> e </span>{% endif %}{% endfor %}{% if group | length > 1 %}<span class="qdv-where">a pari merito</span>{% endif %}</span><span class="qdv-pts">{{ group[0].score }}</span></span>{% else %}<span class="status">Nessun dato provinciale</span>{% endif %}</td>
              {%- endfor %}
            </tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
    </figure>
  </section>

  <section class="section" id="{{ aid('metodo') }}" aria-labelledby="{{ aid('h-metodo') }}">
    <h2 id="{{ aid('h-metodo') }}">Come si calcola, in breve</h2>
    <div class="method">
      <div>
        <h3>In parole semplici</h3>
        <p>Per ogni indicatore si guarda quanto un territorio si allontana dalla media dei territori dello stesso livello, nel verso giusto: dove è meglio un valore alto, un valore alto alza il punteggio, dove è meglio basso lo abbassa.</p>
        <p>Gli indicatori si raggruppano in dimensioni, dal reddito alla salute alla sicurezza, e le dimensioni si combinano con i pesi del profilo. Il risultato va da 0 a 100{% if r.fifty and p.fifty %}, e 50 è la media{% endif %}. Regioni e province hanno classifiche separate, ognuna con i suoi indicatori.</p>
      </div>
      <div>
        <h3>Il calcolo</h3>
        <dl>
          <div><dt>Metodo</dt><dd>Per ogni indicatore uno z-score orientato, che conserva le distanze fra i territori, riportato su una scala da 0 a 100 dove una deviazione standard vale {{ d.spread }} punti.</dd></div>
          {% for b in d.levels %}
          <div><dt>Le fonti per le {{ b.spec.plural }}, su {{ b.dims }} dimensioni</dt><dd><ul class="reflist">{% for s in b.breakdown %}<li>{{ s.label }}: {{ s.count }} indicatori</li>{% endfor %}</ul></dd></div>
          {% endfor %}
          <div><dt>Che cosa non è</dt><dd>Una sintesi di Divario Italia, con dimensioni e versi scelti dalla redazione e rivedibili. Non è la classifica del Sole 24 Ore.</dd></div>
        </dl>
        <p class="qv-method-links"><a class="linkarrow" href="{{ href('/metodologia#qualita-della-vita') }}">Il metodo per intero</a> <a class="linkarrow" href="{{ href('/metodologia#indicatori-usati') }}">Quali indicatori entrano nel punteggio</a></p>
      </div>
    </div>
  </section>

  <section class="section" id="{{ aid('scarica') }}" aria-labelledby="{{ aid('h-scarica') }}">
    <h2 id="{{ aid('h-scarica') }}">Scarica i dati</h2>
    <p class="qv-download-note">Le due classifiche con il profilo {{ d.default_name }}: in CSV la posizione e il punteggio di ogni territorio, in JSON anche il punteggio di ogni dimensione. Licenza <a href="{{ data_license_url }}">{{ data_license_label }}</a>.</p>
    <div class="actions">
      <a class="btn btn--primary" href="{{ href(d.downloads.regione.csv) }}">{{ ui.icon('download') }} Le regioni in CSV</a>
      <a class="btn" href="{{ href(d.downloads.regione.json) }}">{{ ui.icon('download') }} Le regioni in JSON</a>
      <a class="btn" href="{{ href(d.downloads.provincia.csv) }}">{{ ui.icon('download') }} Le province in CSV</a>
      <a class="btn" href="{{ href(d.downloads.provincia.json) }}">{{ ui.icon('download') }} Le province in JSON</a>
    </div>
  </section>
</div>

<section class="band" aria-labelledby="{{ aid('continua-da-qui') }}">
  <div class="wrap">
    <h2 class="h-section" id="{{ aid('continua-da-qui') }}">Continua da qui</h2>
    <div class="lanes">
      <div class="lane">
        <h3>I territori</h3>
        <ul>
          <li><a href="{{ href(r.spec.index) }}">I profili delle {{ r.n }} regioni</a></li>
          <li><a href="{{ href('/confronto') }}">Metti a confronto due territori</a></li>
        </ul>
      </div>
      <div class="lane">
        <h3>Gli indicatori</h3>
        <ul>
          <li><a href="{{ href('/temi') }}">Tutti gli indicatori per tema</a></li>
          <li><a href="{{ href('/atlante') }}">L'atlante degli indicatori</a></li>
          <li><a href="{{ href('/catalogo-dati') }}">Il catalogo dei dati</a></li>
        </ul>
      </div>
      <div class="lane">
        <h3>Da leggere</h3>
        <ul>
          <li><a href="{{ href('/divari-regionali') }}">I divari fra Nord, Centro e Mezzogiorno</a></li>
          <li><a href="{{ href('/blog') }}">Le storie di Divario Italia</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>
{% endblock %}
