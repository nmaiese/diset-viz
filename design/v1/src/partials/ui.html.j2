{#- I componenti della 1.0 come macro. Ogni macro produce il markup di un
    componente del catalogo in SISTEMA.md, e il CSS lo veste in components.css. -#}

{% macro icon(name) -%}
{%- if name == 'search' -%}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
{%- elif name == 'chevron' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
{%- elif name == 'menu' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
{%- elif name == 'theme' -%}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"/></svg>
{%- elif name == 'star' -%}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8L3.5 9.7l5.9-.9z"/></svg>
{%- elif name == 'download' -%}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
{%- elif name == 'copy' -%}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="8" y="8" width="12" height="12"/><path d="M16 8V4H4v12h4"/></svg>
{%- elif name == 'up' -%}<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 3 13 11H3z" fill="currentColor"/></svg>
{%- elif name == 'down' -%}<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 13 3 5h10z" fill="currentColor"/></svg>
{%- elif name == 'info' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
{%- endif -%}
{%- endmacro %}

{% macro crumbs(trail) -%}
<nav class="crumbs" aria-label="Percorso">
  <ol>
    {%- for step in trail %}
    <li>{% if loop.last %}<span aria-current="page">{{ step.name }}</span>{% else %}<a href="{{ href(step.path) }}">{{ step.name }}</a>{% endif %}</li>
    {%- endfor %}
  </ol>
</nav>
{%- endmacro %}

{% macro tiles(items) -%}
<dl class="tiles" style="--tiles: {{ items | length }}">
  {%- for t in items %}
  <div class="tile">
    <dt>{{ t.label }}</dt>
    <dd><span class="figure-num">{{ t.num }}{% if t.unit %}<span class="u">{{ t.unit }}</span>{% endif %}</span>
      {%- if t.sub %}<span class="sub">{% if t.href %}<a href="{{ href(t.href) }}">{{ t.sub }}</a>{% else %}{{ t.sub }}{% endif %}</span>{% endif %}</dd>
  </div>
  {%- endfor %}
</dl>
{%- endmacro %}

{#- La mappa: aria-hidden, perche' la tabella accanto porta gli stessi dati e i
    link che la mappa avrebbe. Il mouse ci passa sopra, la tastiera usa la
    tabella e il campo "Trova la tua regione". -#}
{% macro map(classes, keyname, names, values=None, selected=None, small=False) -%}
<div class="map{{ ' map--small' if small }}" data-map>
  <svg viewBox="0 0 560 660" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="{{ aid('nd-' ~ keyname) }}" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="4" height="4" style="fill: var(--data-null)"/><line x1="0" y1="0" x2="0" y2="4" style="stroke: var(--data-null-stripe); stroke-width: 1"/>
      </pattern>
    </defs>
    {%- for key, d in paths.items() %}
    <path d="{{ d }}" data-key="{{ key }}" data-name="{{ names.get(key, key) }}"{% if values %} data-value="{{ values.get(key, '') }}"{% endif %} class="{{ classes.get(key, '') }}{{ ' is-on' if key == selected }}"{% if key not in classes %} style="fill: url(#{{ aid('nd-' ~ keyname) }})"{% endif %}/>
    {%- endfor %}
  </svg>
  <div class="map__tip" data-map-tip hidden></div>
</div>
{%- endmacro %}

{% macro legend(lg, caption) -%}
<div class="legend" aria-hidden="true">
  <div class="legend__ramp">{% for i in range(1, 7) %}<i class="q{{ i }}" style="background: var(--seq-{{ i }})"></i>{% endfor %}</div>
  <div class="legend__scale"><span data-legend="min">{{ lg.min }}</span><span data-legend="mid">{{ lg.mid }}</span><span data-legend="max">{{ lg.max }}</span></div>
  <span class="legend__caption">{{ caption }}</span>
  <span class="legend__nd"><i></i> n.d., dato non disponibile</span>
</div>
{%- endmacro %}

{% macro ad(kind='') -%}
<aside class="ad{{ ' ad--' ~ kind if kind }}" aria-label="Pubblicità"><span>Spazio pubblicitario riservato</span></aside>
{%- endmacro %}

{% macro cite(text) -%}
<div class="cite">
  <p data-cite-text>{{ text }}</p>
  <button class="btn" type="button" data-copy>{{ icon('copy') }} <span>Copia la citazione</span></button>
  <span class="sr-only" role="status" data-copy-status></span>
</div>
{%- endmacro %}
