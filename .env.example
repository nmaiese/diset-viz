# Backend mutabile Supabase (Fase 4). Vuoti = SQLite locale + auth off: il sito
# e il gioco anonimo girano comunque. In produzione stanno su Cloud Run
# (segreti in Secret Manager per i primi tre, env pubbliche per gli altri).
# DATABASE_URL: pooler Supavisor, porta 6543, transaction mode, sslmode=require.
DATABASE_URL=
# DIRECT_URL: connessione diretta, porta 5432, usata solo da Alembic.
DIRECT_URL=
# SUPABASE_JWT_SECRET: segreto HS256 per verificare i JWT (o vuoto -> JWKS).
SUPABASE_JWT_SECRET=
# Pubbliche (finiscono nel browser via i template):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# La sola mail ammessa alla console /_pipeline/console (default: la tua).
MONITOR_ADMIN_EMAIL=maiese.next@gmail.com
